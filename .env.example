# ═══════════════════════════════════════
# NEXA OS — Configuración de Entorno
# Copia a .env y rellena con tus valores
# ═══════════════════════════════════════

# --- SERVIDOR ---
PORT=7860
PYTHONUNBUFFERED=1
FENIX_ENABLED=true
NEXA_DEV_MODE=false

# --- SEGURIDAD ---
# Secreto para generar API keys del backend
NEXA_API_SECRET=genera_un_secreto_fuerte_de_32_chars
# Desactivar autenticación (solo para desarrollo local)
NEXA_AUTH_DISABLED=false

# --- PROTOCOLO FÉNIX ---
ECHO_VAULT_PATH=/data/nexa_echo_vault
GPG_KEY_ID=tu_key_id_8_chars
GPG_PASSPHRASE=tu_passphrase_segura

# --- OLLAMA ---
OLLAMA_HOST_URL=http://127.0.0.1:11434

# --- PROVEEDORES DE AI (Server-Side — NUNCA exponer al frontend) ---
GEMINI_API_KEY=tu_gemini_key
GROQ_API_KEY=tu_groq_key
OPENAI_API_KEY=tu_openai_key
NVIDIA_API_KEY=tu_nvidia_key
DEEPSEEK_API_KEY=tu_deepseek_key
ANTHROPIC_API_KEY=tu_anthropic_key

# --- FRONTEND (Variables VITE_ sí se exponen al browser) ---
# Apuntar al backend proxy en vez de a APIs directas
VITE_BACKEND_URL=https://tu-proyecto.railway.app
VITE_HF_BACKEND_URL=https://tu-proyecto.railway.app

# Supabase (público por diseño)
VITE_SUPABASE_URL=tu_supabase_url
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Ollama local (solo para dev)
VITE_OLLAMA_URL=http://127.0.0.1:11434

# --- BASE DE DATOS ---
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- RAILWAY ---
RAILWAY_DOMAIN=https://tu-proyecto.railway.app

# --- MONITOREO (Sentry) ---
SENTRY_ORG=tu_sentry_org
SENTRY_PROJECT=tu_sentry_project
NEXT_PUBLIC_SENTRY_DSN=https://tu_dsn@sentry.io/tu_project_id
