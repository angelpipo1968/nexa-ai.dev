{
    "$schema": "https://schema.railpack.com",
    "provider": "node",
    "packages": {
        "node": "20"
    },
    "steps": {
        "install": {
            "inputs": [{"local": true}],
            "commands": ["npm install --legacy-peer-deps"]
        },
        "build": {
            "inputs": [{"step": "install"}],
            "commands": ["NODE_OPTIONS='--max-old-space-size=4096' npm run build"]
        }
    },
    "deploy": {
        "startCommand": "npm start"
    }
}
